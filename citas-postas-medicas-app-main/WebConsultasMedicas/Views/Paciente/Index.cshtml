@model IReadOnlyList<WebConsultasMedicas.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Mantenimiento de pacientes.</p>
    <a class="btn btn-primary" asp-action="Create">Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>DNI</th>
                    <th>Paciente</th>
                    <th>HCL</th>
                    <th>Usuario</th>
                    <th style="width: 110px;">Estado</th>
                    <th style="width: 260px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay pacientes.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.DNI</td>
                            <td>@($"{item.ApellidoPaterno} {item.ApellidoMaterno}, {item.Nombres}")</td>
                            <td class="text-muted">@item.NumeroSIS</td>
                            <td class="text-muted">@item.Usuario?.Correo</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdPaciente">Editar</a>
                                <form asp-action="ToggleEstado" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idPaciente" value="@item.IdPaciente" />
                                    @if (item.Estado)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Inactivar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                    }
                                </form>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="CambiarClave" asp-route-idPaciente="@item.IdPaciente">Cambiar contraseña</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


