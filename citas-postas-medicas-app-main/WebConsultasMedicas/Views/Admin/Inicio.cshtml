@{
    ViewData["Title"] = "Inicio";
}

@model WebConsultasMedicas.Models.Dashboard.AdminDashboardViewModel

<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Usuarios</div>
                <div class="fs-3 fw-semibold">@Model.TotalUsuarios</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Pacientes</div>
                <div class="fs-3 fw-semibold">@Model.TotalPacientes</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Médicos</div>
                <div class="fs-3 fw-semibold">@Model.TotalMedicos</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted">Citas hoy</div>
                <div class="fs-3 fw-semibold">@Model.CitasHoy</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-12 col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Estado de citas</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">Programadas</div>
                            <div class="fs-4 fw-semibold">@Model.Programadas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">Atendidas</div>
                            <div class="fs-4 fw-semibold">@Model.Atendidas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">Canceladas</div>
                            <div class="fs-4 fw-semibold">@Model.Canceladas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">Reprogramadas</div>
                            <div class="fs-4 fw-semibold">@Model.Reprogramadas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">No asistió</div>
                            <div class="fs-4 fw-semibold">@Model.NoAsistio</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-3">
                            <div class="text-muted">Próx. 7 días</div>
                            <div class="fs-4 fw-semibold">@Model.CitasProx7Dias</div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-muted small">
                    Tip: los reportes de Excel están en el menú <strong>Reportes</strong>.
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong>Top especialidades</strong>
            </div>
            <div class="card-body">
                @if (Model.TopEspecialidades.Count == 0)
                {
                    <div class="text-muted">Aún no hay citas registradas.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Especialidad</th>
                                    <th class="text-end">Citas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TopEspecialidades)
                                {
                                    <tr>
                                        <td>@item.Especialidad</td>
                                        <td class="text-end">@item.Total</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

