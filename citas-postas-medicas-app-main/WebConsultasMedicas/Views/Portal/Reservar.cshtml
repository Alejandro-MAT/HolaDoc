@model WebConsultasMedicas.Models.PortalReservarViewModel

@{
    ViewData["Title"] = "Reservar cita";
    var horario = Model.Horario;
    var bloqueText = horario is null ? string.Empty : $"{horario.HoraInicio:hh\\:mm tt}-{horario.HoraFin:hh\\:mm tt}";
    var fechaText = horario is null ? string.Empty : horario.Fecha.ToString("yyyy-MM-dd");
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Reservar cita</h2>
        <p class="text-muted mb-0">
            @(horario is null ? "" : $"{horario.Medico?.Especialidad?.Nombre} / {horario.Medico?.ApellidoPaterno} {horario.Medico?.ApellidoMaterno}, {horario.Medico?.Nombres}")
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Buscar">Volver</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Reservar" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdHorarioMedico" />
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            @if (User.IsInRole("Administrador"))
            {
                <div class="col-12">
                    <label asp-for="IdPaciente" class="form-label">Paciente</label>
                    <select asp-for="IdPaciente" class="form-select" asp-items="Model.Pacientes">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="IdPaciente" class="text-danger"></span>
                </div>
            }

            <div class="col-md-4">
                <label class="form-label">Fecha</label>
                <input class="form-control" value="@fechaText" disabled />
                <input type="hidden" asp-for="FechaCita" />
                <span asp-validation-for="FechaCita" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Hora</label>
                <input class="form-control" value="@Model.HoraCita.ToString("hh:mm tt")" disabled />
                <input type="hidden" asp-for="HoraCita" />
                <span asp-validation-for="HoraCita" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Bloque</label>
                <input class="form-control" value="@bloqueText" disabled />
            </div>

            <div class="col-12">
                <label asp-for="MotivoConsulta" class="form-label">Motivo</label>
                <input asp-for="MotivoConsulta" class="form-control" autocomplete="off" />
                <span asp-validation-for="MotivoConsulta" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Observacion" class="form-label"></label>
                <textarea asp-for="Observacion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observacion" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar reserva</button>
                <a asp-action="Buscar" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



