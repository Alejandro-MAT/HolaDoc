@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();

    var isAdmin = User.IsInRole("Administrador");
    var isPaciente = User.IsInRole("Paciente");
    var isMedico = User.IsInRole("Medico");

    var inicioController = isAdmin ? "Admin" : isMedico ? "MedicoPortal" : "Portal";
    var inicioAction = isAdmin ? "Inicio" : isMedico ? "MisCitas" : "Buscar";

    var isInicioActive =
        (isAdmin && currentController == "admin" && currentAction == "inicio") ||
        (isMedico && currentController == "medicoportal" && currentAction == "miscitas") ||
        (isPaciente && currentController == "portal" && currentAction == "buscar");

    var mantenimientoExpanded = currentController is "especialidad" or "turno" or "estadocita" or "rol" or "usuario";
    var personalExpanded = currentController is "medico" or "paciente";
    var agendaExpanded = currentController is "horariomedico" or "citamedica" or "historialcita";
    var reportesExpanded = currentController == "reportes";
    var portalExpanded = currentController == "portal";
    var medicoExpanded = currentController == "medicoportal";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HolaDoc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebConsultasMedicas.styles.css" asp-append-version="true" />
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <span class="brand-symbol" style="background: transparent; box-shadow: none; color: #157a6e; width: auto;">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                    <path d="M9 22v-4h6v4"></path>
                    <path d="M8 11h8"></path>
                    <path d="M12 7v8"></path>
                </svg>
            </span>
            <div class="brand-text">
                <strong>HolaDoc</strong>
                <small>Acceso a citas</small>
            </div>
        </div>

        <nav class="admin-nav">
            <a class="admin-link @(isInicioActive ? "active" : "")" asp-controller="@inicioController" asp-action="@inicioAction">
                <span class="admin-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                        <path d="M12 3 3 10v11h6v-6h6v6h6V10l-9-7z" fill="currentColor" />
                    </svg>
                </span>
                <span>Inicio</span>
            </a>

            @* Paciente/Admin: Portal de citas *@
            @if (isAdmin || isPaciente)
            {
                <button class="admin-link admin-link-toggle @(portalExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-portal"
                        aria-expanded="@(portalExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-portal">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 17.9V20h-2v-.1a8 8 0 0 1-6.9-6.9H4v-2h.1A8 8 0 0 1 11 4.1V4h2v.1a8 8 0 0 1 6.9 6.9H20v2h-.1A8 8 0 0 1 13 19.9z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Citas</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(portalExpanded ? "show" : "")" id="app-portal">
                    <a class="admin-sublink @(currentController == "portal" && currentAction == "buscar" ? "active" : "")" asp-controller="Portal" asp-action="Buscar">Agendar cita</a>
                    @if (isPaciente)
                    {
                        <a class="admin-sublink @(currentController == "portal" && currentAction == "miscitas" ? "active" : "")" asp-controller="Portal" asp-action="MisCitas">Mis citas</a>
                    }
                </div>
            }

            @* Médico: módulo de atención *@
            @if (isAdmin || isMedico)
            {
                <button class="admin-link admin-link-toggle @(medicoExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-medico"
                        aria-expanded="@(medicoExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-medico">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm-9 9a9 9 0 0 1 18 0H3z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Atención</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(medicoExpanded ? "show" : "")" id="app-medico">
                    <a class="admin-sublink @(currentController == "medicoportal" && currentAction == "miscitas" ? "active" : "")" asp-controller="MedicoPortal" asp-action="MisCitas">Mis citas</a>
                </div>
            }

            @* Admin: mantenedores *@
            @if (isAdmin)
            {
                <button class="admin-link admin-link-toggle @(mantenimientoExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-mantenimiento"
                        aria-expanded="@(mantenimientoExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-mantenimiento">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M19.14 12.94a7.49 7.49 0 0 0 .05-.94 7.49 7.49 0 0 0-.05-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.28 7.28 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 14.9 2h-3.8a.5.5 0 0 0-.49.42l-.36 2.54a7.28 7.28 0 0 0-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L3.71 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.49 7.49 0 0 0-.05.94 7.49 7.49 0 0 0 .05.94l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96a7.28 7.28 0 0 0 1.63.94l.36 2.54a.5.5 0 0 0 .49.42h3.8a.5.5 0 0 0 .49-.42l.36-2.54a7.28 7.28 0 0 0 1.63-.94l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1 1 15.5 12 3.5 3.5 0 0 1 12 15.5z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Mantenimiento</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(mantenimientoExpanded ? "show" : "")" id="app-mantenimiento">
                    <a class="admin-sublink @(currentController == "especialidad" ? "active" : "")" asp-controller="Especialidad" asp-action="Index">Especialidades</a>
                    <a class="admin-sublink @(currentController == "turno" ? "active" : "")" asp-controller="Turno" asp-action="Index">Turnos</a>
                    <a class="admin-sublink @(currentController == "estadocita" ? "active" : "")" asp-controller="EstadoCita" asp-action="Index">Estados de cita</a>
                    <a class="admin-sublink @(currentController == "rol" ? "active" : "")" asp-controller="Rol" asp-action="Index">Roles</a>
                    <a class="admin-sublink @(currentController == "usuario" ? "active" : "")" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                </div>

                <button class="admin-link admin-link-toggle @(personalExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-personal"
                        aria-expanded="@(personalExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-personal">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm-9 9a9 9 0 0 1 18 0H3z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Personal</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(personalExpanded ? "show" : "")" id="app-personal">
                    <a class="admin-sublink @(currentController == "medico" ? "active" : "")" asp-controller="Medico" asp-action="Index">Médicos</a>
                    <a class="admin-sublink @(currentController == "paciente" ? "active" : "")" asp-controller="Paciente" asp-action="Index">Pacientes</a>
                </div>

                <button class="admin-link admin-link-toggle @(agendaExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-agenda"
                        aria-expanded="@(agendaExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-agenda">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 18H5V9h14v11zm0-13H5V6h14v1z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Agenda</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(agendaExpanded ? "show" : "")" id="app-agenda">
                    <a class="admin-sublink @(currentController == "horariomedico" ? "active" : "")" asp-controller="HorarioMedico" asp-action="Index">Horarios médicos</a>
                    <a class="admin-sublink @(currentController == "citamedica" ? "active" : "")" asp-controller="CitaMedica" asp-action="Index">Citas médicas</a>
                    <a class="admin-sublink @(currentController == "historialcita" ? "active" : "")" asp-controller="HistorialCita" asp-action="Index">Historial de citas</a>
                </div>

                <button class="admin-link admin-link-toggle @(reportesExpanded ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#app-reportes"
                        aria-expanded="@(reportesExpanded.ToString().ToLowerInvariant())"
                        aria-controls="app-reportes">
                    <span class="admin-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M4 3h16v18H4V3zm2 2v14h12V5H6zm2 2h8v2H8V7zm0 4h8v2H8v-2zm0 4h6v2H8v-2z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="flex-grow-1 text-start">Reportes</span>
                    <span class="admin-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </button>

                <div class="collapse @(reportesExpanded ? "show" : "")" id="app-reportes">
                    <a class="admin-sublink @(currentController == "reportes" && currentAction == "atencionespormedico" ? "active" : "")" asp-controller="Reportes" asp-action="AtencionesPorMedico">Atenciones por médico</a>
                    <a class="admin-sublink @(currentController == "reportes" && currentAction == "historialpaciente" ? "active" : "")" asp-controller="Reportes" asp-action="HistorialPaciente">Historial del paciente</a>
                </div>
            }

        </nav>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-row">
                <div class="admin-title">
                    <h1 class="h4 m-0">@ViewData["Title"]</h1>
                </div>
                <div class="admin-topbar-actions">
                    @await Component.InvokeAsync("UserMenu")
                </div>
            </div>
        </header>

        <main class="admin-content" role="main">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

