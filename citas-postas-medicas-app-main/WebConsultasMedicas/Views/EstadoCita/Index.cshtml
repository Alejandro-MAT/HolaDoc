@model IReadOnlyList<WebConsultasMedicas.Models.EstadoCita>

@{
    ViewData["Title"] = "Estado de cita";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Mantenimiento de estados de cita.</p>
    <a class="btn btn-primary" asp-action="Create">Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 90px;">ID</th>
                    <th>Nombre</th>
                    <th style="width: 180px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No hay estados.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdEstadoCita</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdEstadoCita">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdEstadoCita">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


