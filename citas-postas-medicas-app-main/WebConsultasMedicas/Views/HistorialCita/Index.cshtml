@model IReadOnlyList<WebConsultasMedicas.Models.HistorialCita>

@{
    ViewData["Title"] = "Historial de citas";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Últimos 300 cambios de estado.</p>
    <a class="btn btn-primary" asp-action="Create">Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 90px;">ID</th>
                    <th style="width: 110px;">Cita</th>
                    <th>Paciente</th>
                    <th style="width: 160px;">Estado</th>
                    <th style="width: 200px;">Fecha cambio</th>
                    <th style="width: 180px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay historial.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdHistorial</td>
                            <td class="fw-semibold">@item.IdCita</td>
                            <td>@($"{item.CitaMedica?.Paciente?.ApellidoPaterno} {item.CitaMedica?.Paciente?.ApellidoMaterno}, {item.CitaMedica?.Paciente?.Nombres}")</td>
                            <td>
                                @switch (item.IdEstadoCita)
                                {
                                    case 2:
                                        <span class="badge bg-success">@item.EstadoCita?.Nombre</span>
                                        break;
                                    case 3:
                                    case 5:
                                        <span class="badge bg-danger">@item.EstadoCita?.Nombre</span>
                                        break;
                                    case 4:
                                        <span class="badge bg-warning text-dark">@item.EstadoCita?.Nombre</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@item.EstadoCita?.Nombre</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted">@item.FechaCambio.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdHistorial">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdHistorial">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>



