@model WebConsultasMedicas.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-page">
    <div class="login-hero">
        <h1>Bienvenido al Sistema de Gestión de Citas Medicas.</h1>

        <div class="hero-metrics">
            <div class="metric-card">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: #157a6e;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <strong style="margin: 0; color: #17363d;">Citas</strong>
                </div>
                <span>Agenda diaria centralizada para clínicas y especialistas.</span>
            </div>
            <div class="metric-card">
                <div style="display: flex; align-items: center; gap: 0.5rem; color: #157a6e;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <strong style="margin: 0; color: #17363d;">Coordinación</strong>
                </div>
                <span>Mantén doctores y pacientes en la misma sintonía.</span>
            </div>
        </div>
    </div>

    <div class="login-card">
        <div class="login-card-header">
            <span class="login-kicker">Acceso profesional</span>
            <h2>Iniciar sesión</h2>
            <p>Ingresa tus credenciales para continuar a la plataforma de citas médicas.</p>
        </div>

        <form class="login-form" method="post" asp-controller="Auth" asp-action="Login">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success" role="alert">@successMessage</div>
            }

            <div class="input-group-custom">
                <label asp-for="EmailAddress"></label>
                <input asp-for="EmailAddress" class="form-control" placeholder="doctor@clinic.com" autocomplete="username" />
                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Password"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control js-password" placeholder="Ingresa tu contraseña" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                        <svg class="js-eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="login-options">
                <label class="remember-session" asp-for="RememberSession">
                    <input asp-for="RememberSession" />
                    <span>@Html.DisplayNameFor(m => m.RememberSession)</span>
                </label>
                <a asp-controller="Auth" asp-action="Register" class="login-link">Crear cuenta</a>
            </div>

            <button type="submit" class="login-submit-button">Ingresar a la plataforma</button>
        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const togglePassword = document.querySelector('.js-toggle-password');
            const passwordInput = document.querySelector('.js-password');
            const eyeIcon = document.querySelector('.js-eye-icon');

            if (togglePassword && passwordInput && eyeIcon) {
                togglePassword.addEventListener('click', function () {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    
                    if (type === 'text') {
                        // Icono de ojo tachado (ocultar)
                        eyeIcon.innerHTML = '<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>';
                        this.setAttribute('aria-label', 'Ocultar contraseña');
                        this.setAttribute('title', 'Ocultar contraseña');
                    } else {
                        // Icono de ojo normal (mostrar)
                        eyeIcon.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />';
                        this.setAttribute('aria-label', 'Mostrar contraseña');
                        this.setAttribute('title', 'Mostrar contraseña');
                    }
                });
            }
        });
    </script>
}

