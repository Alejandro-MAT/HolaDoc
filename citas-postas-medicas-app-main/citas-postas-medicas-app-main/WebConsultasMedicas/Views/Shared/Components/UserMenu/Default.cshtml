@model WebConsultasMedicas.ViewComponents.UserMenuVm

@{
    var initials = "U";
    if (!string.IsNullOrWhiteSpace(Model.DisplayName))
    {
        var parts = Model.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            initials = $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }
        else if (parts.Length == 1)
        {
            initials = parts[0][0].ToString().ToUpperInvariant();
        }
    }
}

<div class="dropdown">
    <button class="btn btn-link text-decoration-none dropdown-toggle user-menu-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        <span class="user-menu-avatar">@initials</span>
        <span class="user-menu-name">@Model.DisplayName</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li class="dropdown-header">@Model.DisplayRole</li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Salir</a>
        </li>
    </ul>
</div>


