@model IReadOnlyList<WebConsultasMedicas.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Mantenimiento de usuarios.</p>
    <a class="btn btn-primary" asp-action="Create">Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Correo</th>
                    <th style="width: 160px;">Rol</th>
                    <th style="width: 110px;">Estado</th>
                    <th style="width: 180px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No hay usuarios.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Correo</td>
                            <td class="text-muted">@item.Rol?.Nombre</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdUsuario">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdUsuario">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


