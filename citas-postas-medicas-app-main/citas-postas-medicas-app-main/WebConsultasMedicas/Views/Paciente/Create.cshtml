@model WebConsultasMedicas.Models.AdminPacienteCreateViewModel

@{
    ViewData["Title"] = "Nuevo paciente";
}

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()

            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="col-md-6">
                <label asp-for="Correo" class="form-label">Correo</label>
                <div class="input-group">
                    <input asp-for="Correo" class="form-control" autocomplete="off" placeholder="usuario" />
                    <span class="input-group-text">@@siscitasweb.local</span>
                </div>
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control js-password" type="password" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Mostrar contraseña">
                        <span class="js-eye">Ver</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control js-password" type="password" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Mostrar contraseña">
                        <span class="js-eye">Ver</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control" autocomplete="off" />
                <span asp-validation-for="DNI" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="FechaNacimiento" class="form-label">Fecha nacimiento</label>
                <input asp-for="FechaNacimiento" asp-format="{0:dd/MM/yyyy}" class="form-control" type="date" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Sexo" class="form-label"></label>
                <select asp-for="Sexo" class="form-select">
                    <option value="M">M</option>
                    <option value="F">F</option>
                </select>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ApellidoPaterno" class="form-label">Apellido Paterno</label>
                <input asp-for="ApellidoPaterno" class="form-control" autocomplete="off" />
                <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ApellidoMaterno" class="form-label">Apellido Materno</label>
                <input asp-for="ApellidoMaterno" class="form-control" autocomplete="off" />
                <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Nombres" class="form-label"></label>
                <input asp-for="Nombres" class="form-control" autocomplete="off" />
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" autocomplete="off" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Direccion" class="form-label"></label>
                <textarea asp-for="Direccion" class="form-control" rows="2" autocomplete="off"></textarea>
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" />
                    <label asp-for="Estado" class="form-check-label">Activo</label>
                </div>
                <div class="form-text">La historia clínica (HCLIN#####) se genera automáticamente.</div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


