@model IReadOnlyList<WebConsultasMedicas.Models.HorarioMedico>
@using System.Globalization

@{
    ViewData["Title"] = "Horarios médicos";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Gestión de horarios por médico y fecha.</p>
    <a class="btn btn-primary" asp-action="Create">Nuevo</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Médico</th>
                    <th>Especialidad</th>
                    <th>Turno</th>
                    <th style="width: 170px;">Fecha</th>
                    <th style="width: 160px;">Horas</th>
                    <th style="width: 110px;">Estado</th>
                    <th style="width: 180px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay horarios.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var diaNombre = CultureInfo.GetCultureInfo("es-PE").DateTimeFormat.GetDayName(item.Fecha.ToDateTime(TimeOnly.MinValue).DayOfWeek);
                        diaNombre = string.IsNullOrWhiteSpace(diaNombre) ? "" : char.ToUpper(diaNombre[0]) + diaNombre[1..];

                        <tr>
                            <td>@($"{item.Medico?.ApellidoPaterno} {item.Medico?.ApellidoMaterno}, {item.Medico?.Nombres}")</td>
                            <td class="fw-semibold">@item.Especialidad?.Nombre</td>
                            <td class="text-muted">@item.Turno?.Nombre</td>
                            <td>
                                <div class="fw-semibold">@diaNombre</div>
                                <div class="text-muted small">@item.Fecha.ToString("yyyy-MM-dd")</div>
                            </td>
                            <td class="text-muted">@($"{item.HoraInicio:hh\\:mm tt} - {item.HoraFin:hh\\:mm tt}")</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdHorarioMedico">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdHorarioMedico">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>




