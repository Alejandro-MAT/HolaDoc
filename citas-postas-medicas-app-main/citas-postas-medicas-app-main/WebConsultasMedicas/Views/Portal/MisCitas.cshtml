@model IReadOnlyList<WebConsultasMedicas.Models.CitaMedica>

@{
    ViewData["Title"] = "Mis citas";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Mis citas</h2>
        <p class="text-muted mb-0">Últimas 200 citas.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Buscar">Buscar horarios</a>
        <a class="btn btn-outline-danger" asp-controller="Auth" asp-action="Logout">Salir</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 160px;">Fecha</th>
                    <th>Especialidad</th>
                    <th>Médico</th>
                    <th style="width: 160px;">Estado</th>
                    <th style="width: 200px;" class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Aún no tienes citas.</td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted">@($"{c.FechaCita:dd/MM/yyyy} {c.HoraCita:hh\\:mm tt}")</td>
                            <td class="fw-semibold">@c.Especialidad?.Nombre</td>
                            <td>@($"{c.Medico?.ApellidoPaterno} {c.Medico?.ApellidoMaterno}, {c.Medico?.Nombres}")</td>
                            <td>
                                @switch (c.IdEstadoCita)
                                {
                                    case 2:
                                        <span class="badge bg-success">@c.EstadoCita?.Nombre</span>
                                        break;
                                    case 3:
                                    case 5:
                                        <span class="badge bg-danger">@c.EstadoCita?.Nombre</span>
                                        break;
                                    case 4:
                                        <span class="badge bg-warning text-dark">@c.EstadoCita?.Nombre</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@c.EstadoCita?.Nombre</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-idCita="@c.IdCita">Ver detalle</a>
                                @if (c.IdEstadoCita != 3)
                                {
                                    <form asp-action="Cancelar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idCita" value="@c.IdCita" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Cancelar esta cita?');">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">â€”</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>





