@model WebConsultasMedicas.Models.PortalBuscarMedicosViewModel

@{
    ViewData["Title"] = "Agendar cita";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">Agendar cita por especialidad</h2>
        <p class="text-muted mb-0">Elige un médico y luego selecciona su horario.</p>
    </div>
</div>

<form method="get" asp-action="Buscar" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label" for="idEspecialidad">Especialidad</label>
        <select id="idEspecialidad" name="idEspecialidad" class="form-select" asp-items="Model.Especialidades">
            <option value="">-- Todas --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="medico">Médico</label>
        <input id="medico" name="medico" value="@Model.MedicoQuery" class="form-control" placeholder="Nombre o apellido" autocomplete="off" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" type="submit">Buscar</button>
    </div>
</form>

@if (Model.Medicos.Count == 0)
{
    <div class="admin-table-card">
        <div class="p-4 text-center text-muted">
            No se encontraron médicos.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var m in Model.Medicos)
        {
            <div class="col-md-6 col-lg-4">
                <div class="doctor-card h-100">
                    <div class="doctor-card-header">
                        <span class="doctor-specialty-badge">@m.Especialidad?.Nombre</span>
                    </div>
                    <div class="doctor-card-body">
                        <div class="doctor-meta">
                            <div class="doctor-name">@($"{m.ApellidoPaterno} {m.ApellidoMaterno}, {m.Nombres}")</div>
                            <div class="doctor-sub">CMP: @m.CMP</div>
                        </div>
                    </div>
                    <div class="doctor-card-footer">
                        <a class="btn btn-primary w-100" asp-action="Horarios" asp-route-idMedico="@m.IdMedico">Ver horarios</a>
                    </div>
                </div>
            </div>
        }
    </div>
}


