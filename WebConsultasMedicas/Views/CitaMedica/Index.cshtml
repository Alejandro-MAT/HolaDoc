@model IReadOnlyList<WebConsultasMedicas.Models.CitaMedica>

@{
    ViewData["Title"] = "Citas médicas";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <p class="text-muted mb-0">Últimas 200 citas (ordenadas por fecha/hora).</p>
    <a class="btn btn-primary" asp-action="Create">Nueva</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 160px;">Fecha</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Especialidad</th>
                    <th style="width: 140px;">Estado</th>
                    <th style="width: 180px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay citas.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@($"{item.FechaCita:dd/MM/yyyy} {item.HoraCita:hh\\:mm tt}")</td>
                            <td>@($"{item.Paciente?.ApellidoPaterno} {item.Paciente?.ApellidoMaterno}, {item.Paciente?.Nombres}")</td>
                            <td>@($"{item.Medico?.ApellidoPaterno} {item.Medico?.ApellidoMaterno}, {item.Medico?.Nombres}")</td>
                            <td class="fw-semibold">@item.Especialidad?.Nombre</td>
                            <td>
                                @switch (item.IdEstadoCita)
                                {
                                    case 2:
                                        <span class="badge bg-success">@item.EstadoCita?.Nombre</span>
                                        break;
                                    case 3:
                                    case 5:
                                        <span class="badge bg-danger">@item.EstadoCita?.Nombre</span>
                                        break;
                                    case 4:
                                        <span class="badge bg-warning text-dark">@item.EstadoCita?.Nombre</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@item.EstadoCita?.Nombre</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.IdCita">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdCita">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>





