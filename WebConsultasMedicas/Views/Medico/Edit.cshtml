@model WebConsultasMedicas.Models.MedicoAdminViewModel

@{
    ViewData["Title"] = "Editar médico";
}

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdMedico" />
            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="col-md-6">
                <label asp-for="IdEspecialidad" class="form-label">Especialidad</label>
                <select asp-for="IdEspecialidad" class="form-select" asp-items="ViewBag.Especialidades"></select>
                <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
            </div>
            <div class="col-md-6"></div>

            <div class="col-md-6">
                <label asp-for="Correo" class="form-label">Correo (usuario médico)</label>
                <div class="input-group">
                    <input asp-for="Correo" class="form-control" autocomplete="off" placeholder="usuario" />
                    <span class="input-group-text">@@siscitasweb.local</span>
                </div>
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <div class="form-text pt-4">La contraseña se cambia desde <strong>Usuarios</strong>.</div>
            </div>

            <div class="col-md-4">
                <label asp-for="CMP" class="form-label"></label>
                <input asp-for="CMP" class="form-control" autocomplete="off" />
                <span asp-validation-for="CMP" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TiempoAtencionMin" class="form-label"></label>
                <input asp-for="TiempoAtencionMin" class="form-control" type="number" min="1" max="60" />
                <span asp-validation-for="TiempoAtencionMin" class="text-danger"></span>
                <div class="form-text">Máximo 60 minutos.</div>
            </div>
            <div class="col-md-4"></div>

            <div class="col-md-4">
                <label asp-for="ApellidoPaterno" class="form-label"></label>
                <input asp-for="ApellidoPaterno" class="form-control" autocomplete="off" />
                <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ApellidoMaterno" class="form-label"></label>
                <input asp-for="ApellidoMaterno" class="form-control" autocomplete="off" />
                <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Nombres" class="form-label"></label>
                <input asp-for="Nombres" class="form-control" autocomplete="off" />
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" autocomplete="off" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" />
                    <label asp-for="Estado" class="form-check-label">Activo</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

